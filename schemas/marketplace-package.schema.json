{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resourcegrid.local/schemas/marketplace-package.schema.json",
  "title": "Operator Marketplace Capability Package",
  "type": "object",
  "required": [
    "id",
    "slug",
    "name",
    "kind",
    "theme",
    "status",
    "availability",
    "tagline",
    "description",
    "version",
    "publisher",
    "capabilities",
    "platforms",
    "source",
    "packagePath",
    "instructionStatus",
    "trust",
    "pricing"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "skill",
        "tool",
        "operator"
      ]
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "availability": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "openai",
          "claude",
          "codex",
          "mcp",
          "api",
          "vscode",
          "saas"
        ]
      },
      "uniqueItems": true
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "minProperties": 1
    },
    "packagePath": {
      "type": "string",
      "pattern": "^packages/marketplace/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "instructionStatus": {
      "enum": [
        "canonical",
        "composed",
        "source-unavailable"
      ]
    },
    "publisherMeta": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": true
    },
    "trust": {
      "type": "object",
      "required": [
        "verified",
        "status"
      ],
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "pricing": {
      "type": "object",
      "required": [
        "model",
        "free",
        "requiresEntitlement"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "free": {
          "type": "boolean"
        },
        "commercialUse": {
          "type": "boolean"
        },
        "requiresEntitlement": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "maturity": {
      "type": [
        "string",
        "null"
      ]
    },
    "monetizationReadiness": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
