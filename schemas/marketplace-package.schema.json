{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resourcegrid.local/schemas/marketplace-package.schema.json",
  "type": "object",
  "required": [
    "id",
    "slug",
    "name",
    "kind",
    "theme",
    "status",
    "availability",
    "description",
    "version",
    "publisher",
    "capabilities",
    "platforms",
    "source",
    "packagePath",
    "instructionStatus",
    "trust",
    "pricing"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "skill",
        "tool",
        "operator"
      ]
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "openai",
          "claude",
          "codex",
          "mcp",
          "api",
          "vscode",
          "saas"
        ]
      },
      "uniqueItems": true
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "packagePath": {
      "type": "string"
    },
    "instructionStatus": {
      "enum": [
        "canonical",
        "composed",
        "source-unavailable"
      ]
    },
    "trust": {
      "type": "object",
      "required": [
        "verified",
        "status"
      ]
    },
    "pricing": {
      "type": "object",
      "required": [
        "model",
        "free",
        "requiresEntitlement"
      ]
    }
  },
  "additionalProperties": true
}
