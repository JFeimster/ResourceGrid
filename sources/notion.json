{
    "source_id":  "source-notion",
    "name":  "Notion",
    "source_type":  "workspace_and_database_platform",
    "status":  "active",
    "purpose":  "Human operating layer for registries, status, approvals, notes, GPT metadata, partner resources, and planning.",
    "authority":  {
                      "canonical_for":  [
                                            "Notion record identity",
                                            "human-maintained status",
                                            "operator notes",
                                            "approval state"
                                        ],
                      "rule":  "When another platform owns publication or implementation, enrich/reference that canonical entity rather than duplicating it."
                  },
    "ingestion":  {
                      "preferred_method":  "Notion connector",
                      "fallback_method":  "owner-provided export",
                      "raw_destination":  "inbox/raw/notion/",
                      "normalized_destination":  "inbox/normalized/notion/",
                      "preserve_source_ids":  true,
                      "preserve_source_urls":  true
                  },
    "deduplication":  {
                          "strong_keys":  [
                                              "notion_page_id",
                                              "canonical_notion_url"
                                          ],
                          "secondary_keys":  [
                                                 "title",
                                                 "aliases"
                                             ],
                          "merge_duplicate_entities":  true,
                          "preserve_provenance":  true
                      },
    "provenance":  {
                       "required":  true,
                       "required_fields":  [
                                               "source.system",
                                               "source.source_id",
                                               "source.source_url"
                                           ]
                   },
    "sync_policy":  {
                        "mode":  "manual_or_automated_refresh",
                        "stale_after_days":  30,
                        "refresh_before":  [
                                               "reconciliation",
                                               "promotion",
                                               "compilation"
                                           ]
                    },
    "security":  {
                     "store_tokens":  false,
                     "store_secrets":  false,
                     "respect_source_permissions":  true,
                     "expose_private_urls_in_public_outputs":  false
                 },
    "notes":  "Notion is the operator UI; ResourceGrid is the canonical structured registry/compiled intelligence layer."
}
